# Shared secret the Supabase send-email function presents. Generate with:
#   openssl rand -hex 32
EMAIL_SERVICE_TOKEN=

# SMTP credentials you own (Zoho, Gmail app password, your domain host, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Livro Archive <no-reply@livroarchive.com>

PORT=8080
